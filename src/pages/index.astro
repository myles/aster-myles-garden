---
import { getCollection } from "astro:content";

import App from "@/components/App.svelte";
import { toGuideEntries } from "@/components/guide/entries";
import { GUIDE_PATH } from "@/components/guide/topics";
import SiteFooter from "@/components/site/SiteFooter.astro";
import Layout from "@/layouts/Layout.astro";

const guide = toGuideEntries(await getCollection("guide"));
---

<Layout>
  <div class="mx-auto flex min-h-dvh max-w-6xl flex-col px-4 py-8 sm:px-6">
    <header class="mb-8">
      <h1 class="font-serif text-4xl tracking-tight">Aster</h1>
      <p class="mt-1 text-ink-muted">
        A natal chart, calculated in your browser. Nothing you enter leaves this
        page unless you want it to. New to charts?{" "}
        <a class="underline" href={GUIDE_PATH}>
          Read the guide
        </a>
        .
      </p>
    </header>

    <App {guide} client:load />

    <SiteFooter />
  </div>
</Layout>

<script>
  import { registerServiceWorker } from "@/lib/service-worker";

  // Built pages only: in development the worker would cache files Vite is
  // still changing. Registering after load keeps it off the first paint.
  if (import.meta.env.PROD) {
    window.addEventListener("load", () => {
      void registerServiceWorker(navigator.serviceWorker);
    });
  }
</script>
