---
import { getCollection } from "astro:content";

import App from "@/components/App.svelte";
import { toGuideEntries } from "@/components/guide/entries";
import { GUIDE_PATH } from "@/components/guide/topics";
import Identifier from "@/components/ui/Identifier.astro";
import {
  AUTHOR_URL,
  REGISTRY_ENTRY_URL,
  REGISTRY_IDENTIFIER,
  SOURCE_URL,
  VERSION,
} from "@/consts";
import Layout from "@/layouts/Layout.astro";
import { buildReleaseUrl } from "@/lib/release";

const guide = toGuideEntries(await getCollection("guide"));
---

<Layout>
  <div class="mx-auto flex min-h-dvh max-w-6xl flex-col px-4 py-8 sm:px-6">
    <header class="mb-8">
      <h1 class="font-serif text-4xl tracking-tight">Aster</h1>
      <p class="mt-1 text-ink-muted">
        A natal chart, calculated in your browser. Nothing you enter leaves this
        page unless you want it to. New to charts?{" "}
        <a class="underline" href={GUIDE_PATH}>
          Read the guide
        </a>
        .
      </p>
    </header>

    <App {guide} client:load />

    <footer class="mt-12 flex items-start justify-between gap-4 border-t border-rule pt-4 text-xs text-ink-muted">
      <div>
        <p>
          Aster{" "}
          <a class="underline" href={buildReleaseUrl(VERSION)}>
            v{VERSION}
          </a>{" "}
          ·{" "}
          <a class="underline" href={SOURCE_URL}>
            Source code
          </a>{" "}
          (AGPL-3.0)
        </p>
        <p class="mt-1">
          Made by{" "}
          <a class="underline" href={AUTHOR_URL}>
            Myles
          </a>
          , with help from Claude and ChatGPT.
        </p>
        <p class="mt-3">
          Calculations:{" "}
          <a class="underline" href="https://www.astro.com/swisseph/">
            Swiss Ephemeris
          </a>{" "}
          (Astrodienst AG) · Places:{" "}
          <a class="underline" href="https://www.geonames.org/">
            GeoNames
          </a>{" "}
          (
          <a
            class="underline"
            href="https://creativecommons.org/licenses/by/4.0/"
          >
            CC BY 4.0
          </a>
          )
        </p>
      </div>

      <Identifier
        identifier={REGISTRY_IDENTIFIER}
        identifierUrl={REGISTRY_ENTRY_URL}
      />
    </footer>
  </div>
</Layout>

<script>
  import { registerServiceWorker } from "@/lib/service-worker";

  // Built pages only: in development the worker would cache files Vite is
  // still changing. Registering after load keeps it off the first paint.
  if (import.meta.env.PROD) {
    window.addEventListener("load", () => {
      void registerServiceWorker(navigator.serviceWorker);
    });
  }
</script>
