{
  "name": "aster-myles-garden",
  "version": "0.3.0",
  "description": "A birth chart generator that runs entirely in the browser.",
  "license": "AGPL-3.0-only",
  "author": "Myles Braithwaite <myles@myles.garden> (https://myles.garden)",
  "repository": {
    "type": "git",
    "url": "https://github.com/myles/aster-myles-garden.git"
  },
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
    "format": "npm run oxfmt && npm run prettier",
    "format:fix": "npm run oxfmt:write && npm run prettier:write",
    "lint": "npm run oxlint",
    "lint:fix": "npm run oxlint:fix",
    "oxfmt": "oxfmt --check",
    "oxfmt:write": "oxfmt --write",
    "oxlint": "oxlint .",
    "oxlint:fix": "oxlint . --fix",
    "prettier": "prettier \"**/*.{astro,svelte}\" -c",
    "prettier:write": "prettier \"**/*.{astro,svelte}\" --write",
    "preview": "astro preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:linux": "scripts/e2e-linux-run.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.6",
    "@astrojs/vercel": "^11.0.22",
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@myles-garden/styles": "^1.1.0",
    "@swisseph/browser": "^1.4.0",
    "@swisseph/core": "^1.4.0",
    "@swisseph/node": "^1.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "d3-selection": "^3.0.1",
    "d3-shape": "^3.2.1",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@mylesb/oxfmt-config": "^1.0.0",
    "@mylesb/oxlint-config": "^1.0.0",
    "@mylesb/prettier-config": "^1.1.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.78.0",
    "oxlint": "1.93.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-astro-organize-imports": "^0.4.14",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
