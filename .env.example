# Optional personal Spaces trial. These are public build settings, not secrets.
# Leave disabled on main and on public deployments.
ASTER_ATPROTO_TRIAL=false
ASTER_ATPROTO_DID=
# Existing Space URI owned by that DID; use a registered Space type.
ASTER_ATPROTO_SPACE=
# Exact origin used to visit the trial; HTTP is allowed only for 127.0.0.1.
ASTER_ATPROTO_ORIGIN=http://127.0.0.1:4321
